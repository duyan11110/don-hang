// lesson: devops.l2.centralized-logs
// Find the containers of this Compose project through the Docker socket...
discovery.docker "donhang" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=donhang"]
  }
}

// ...label each container's stream with its Compose service: {service="api"}...
discovery.relabel "compose_service" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

// ...read what each one writes to its output, line by line...
loki.source.docker "donhang" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.donhang.targets
  relabel_rules = discovery.relabel.compose_service.rules
  forward_to    = [loki.process.trace_ids.receiver]
}

// lesson: backend.l3.trace-ids-in-logs
// ...from stage-3, copy the trace id out of each JSON line's Scopes into
// structured metadata, trace_id, kept next to the line but not indexed. Not
// a label: a label with a new value for every request would make a new
// stream for every request. A line with no trace id passes through as it is...
loki.process "trace_ids" {
  stage.json {
    expressions = { trace_id = "Scopes[?TraceId] | [0].TraceId" }
  }
  stage.structured_metadata {
    values = { trace_id = "" }
  }
  forward_to = [loki.write.loki.receiver]
}

// ...and send every line to Loki.
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// lesson: backend.l3.opentelemetry-sdk
// From stage-3: spans. Every service sends its spans here over OTLP (gRPC,
// port 4317)...
otelcol.receiver.otlp "services" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces = [otelcol.processor.batch.spans.input]
  }
}

// ...Alloy groups them into batches...
otelcol.processor.batch "spans" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// ...and sends them on to Tempo. Storing traces somewhere else would change
// only this block, not the services.
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
