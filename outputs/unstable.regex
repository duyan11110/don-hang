# One Perl regular expression per line. Whatever a line matches is replaced by
# "..." in every captured output, so that a re-run of the same script produces
# the same file. \K keeps everything before it out of the match.
^Date: \K.*$
^Etag: \K.*$
^Last-Modified: \K.*$
^ *notBefore=\K.*$
^ *notAfter=\K.*$
^\K[0-9]+(?= +sleep )
 in \K[^\n]*[/\\](?=[A-Za-z0-9_]+\.cs:line )
"placedAt":"\K[^"]*(?=")
# design/order-history.sh: the time of a change made just now (a seed order's
# backfilled `placed` time has no fraction of a second, and stays).
"occurredAt":"\K[^"]*\.[0-9]+[^"]*(?=")
"id":\K[0-9]+(?=,"customerId")
actual time=\K[0-9.]+\.\.[0-9.]+
^ *Planning Time: \K[0-9.]+(?= ms$)
^ *Execution Time: \K[0-9.]+(?= ms$)
Executed DbCommand \(\K[0-9]+(?=ms\))
[?&]code=\K[^&\s]+
[?&]session_state=\K[^&\s]+
seconds left on \S+: \K[0-9]+
while locking tuple \K\([0-9]+,[0-9]+\)
^subject: Order \K[0-9]+
^Notification \K[0-9]+(?= failed)
^(?:http|donhang)_\w+(?:\{.*\})? \K\S+$
 => \K\S+$
"ElapsedMs": ?\K[0-9]+
responded [0-9]+ in \K[0-9]+(?=ms)
# Kubernetes (scripts/k8s/): kind's start-up time, AGE and "(… ago)" in kubectl's
# tables, the random part of a Pod or ReplicaSet name, Pod and Service IP
# addresses, and which worker node a Pod landed on.
^ • Ready after \K\S+
(?<=   )(?:[0-9]+[smhd]){1,2}(?=   |$)
\(\K(?:[0-9]+[smhd]){1,2}(?= ago\))
\b(?:web|api|coredns|kindnet|kube-proxy|db|redis|keycloak|mailpit)-\K[bcdfghjklmnpqrstvwxz2456789]{5,10}\b
\b(?:web|api|coredns|db|redis|keycloak|mailpit)-\.\.\.-\K[bcdfghjklmnpqrstvwxz2456789]{5}\b
\b10\.244\.[0-9]+\.[0-9]+\b(?!/)
\b10\.96\.(?!0\.1\b|0\.10\b)[0-9]+\.[0-9]+\b
(?<=   )donhang-worker\K2?(?=   |$)
pod-template-hash=\K[bcdfghjklmnpqrstvwxz2456789]{5,10}\b
# scripts/frontend/web-bundle.sh: sizes in bytes, which change with any
# change to the app, its packages or Flutter.
\b(?:raw|gzip) \K[0-9]+
^bytes sent \K[0-9]+
# Stage-3 messaging and refund scripts: a refund's request time, a fresh
# message id, and the client library's words for a refused connection.
"requestedAt":"\K[^"]*(?=")
message id \K[0-9a-f-]{36}$
attempt [0-9]+ failed \(\K.*(?=\); next attempt)
# Stage-3 resilience scripts: a wait with jitter is random by design.
next attempt in \K[0-9.]+(?= s)
^for order [0-9]+ waits \K[0-9.]+(?= s$)
# How many attempts a refund took depends on when the circuit breaker opened.
^refunded \| \K[0-9]+$
Retry-After: \K[0-9]+$
# Stage-3 tracing scripts: trace and span ids are random on every run.
^traceparent: 00-\K[0-9a-f]{32}-[0-9a-f]{16}(?=-0[01]$)
trace id \K[0-9a-f]{32}
^payments: Refund \K[0-9]+(?= for order)
trace_id="\K[0-9a-f]{32}
# From stage-3 JSON log lines carry "Scopes" (IncludeScopes): span, trace and
# connection ids, new for every request.
(?:SpanId|ParentId)"?: ?"?\K[0-9a-f]{16}
TraceId"?: ?"?\K[0-9a-f]{32}
\b0HN[0-9A-Z]{10}\b
\.\.\.:\K[0-9]{8}\b
# Stage-3 backup scripts: a run's directory, row counts that grow as other
# scripts place orders, WAL positions and times, how long a restore took.
/backups/logical/\K[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9-]+
^ +(?:orders|order_items) \K[0-9]+$
^(?:orders|order_items): \K[0-9]+(?= in counts\.txt)
^(?:orders|order_items): .* \K[0-9]+(?= restored, )
^ *START WAL LOCATION: \K.*$
^ *START TIME: \K.*$
^ *last archived segment \K.*$
^restore and check took \K[0-9]+
^recovery_target_time = \K.*$
# rotate-signing-key.sh: every run's key gets a higher priority, and the api
# fetches Keycloak's keys at most once every 5 minutes.
adding a key with priority \K[0-9]+
new token -> 200 \(after \K[0-9]+
# Stage-3 supply chain: the Grype database is rebuilt every day and the
# findings change with it; the newest published commit, and its digests.
^== vulnerability database built: \K.*$
^(?:Critical|High|Medium|Low|Negligible|Unknown) +\K[0-9]+$
^== ghcr\.io/duyan11110/donhang-[a-z-]+:sha-\K[0-9a-f]{40}
^== ghcr\.io/duyan11110/donhang-[a-z-]+:sha-.* -> ghcr\.io/duyan11110/donhang-[a-z-]+@sha256:\K[0-9a-f]{64}
^Verification for ghcr\.io/duyan11110/donhang-[a-z-]+@sha256:\K[0-9a-f]{64}(?= --)
^built by .* at commit \K[0-9a-f]{40}
# Stage-3 OpenTofu scripts (captured on the host, capture-output.sh
# --devops-host): how long each step took, a namespace's resource version,
# how long a plan waited for the lock.
complete after \K(?:[0-9]+m)?[0-9]+(?=s\b)
resource_version += \K.*$
^it waited about \K[0-9]+(?= s)
# Stage-3 GitOps scripts: commits of the config repository (made on every
# run) and their dates, the start of a SealedSecret's ciphertext, how long
# each step of the DR drill took.
^\K[0-9a-f]{7}(?= [a-z-]+\.sh: )
^\K[0-9a-f]{7}(?= [0-9]{4}-)
^[0-9a-f]{7} \K[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}(?= )
^pushed \K[0-9a-f]{7}$
newest commit in the mirror: \K[0-9a-f]{7}
^    POSTGRES_PASSWORD: \K\S+(?=\.\.\.$)
^ *\K[0-9]+(?= s  [0-9]\. )
^total: \K[0-9]+(?= s from)
^endpoint = "https://127\.0\.0\.1:\K[0-9]+(?=")
# Stage-3 k8s scripts on the host (capture-output.sh --k8s-host): the id in
# a dynamically provisioned volume's name, the fingerprint of the
# certificate kubectl signs in with.
pvc-\K[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}
X509SHA256=\K[0-9a-f]{64}
# deploy-verified.sh: the newest published commit, its digests, the api
# Pods' image; dates of config-repository commits once their hash is masked.
^== deploy sha-\K[0-9a-f]{40}$
^== ghcr\.io/duyan11110/donhang-(?:api|migrate)@sha256:\K[0-9a-f]{64}(?= -> )
^== ghcr\.io/duyan11110/donhang-(?:api|migrate)@sha256:(?:\.\.\.|[0-9a-f]{64}) -> ghcr\.io/duyan11110/donhang-(?:api|migrate)@sha256:\K[0-9a-f]{64}$
^ +[0-9]+ ghcr\.io/duyan11110/donhang-api:sha-\K[0-9a-f]{40}@sha256:[0-9a-f]{64}$
Deploy verified api sha-\K[0-9a-f]{40}
^\.\.\. \K[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}(?= )
# statefulset-db.sh: the time on PostgreSQL's log line.
^\K[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+(?= \+07 \[[0-9]+\] LOG:)
# Stage-3 k8s scripts of networking-deep, bare-metal and
# operators-and-cluster-lifecycle (capture-output.sh --k8s-host): the random
# parts of more Pod names, node ports Kubernetes picked, kube-proxy's chain
# for one Pod (named from its address), hardware (MAC) addresses of node
# containers, how long a failover took, certificate expiry dates, the port
# kind gave donhang-ha's load balancer. (Pod ranges such as 10.244.1.0/24
# stay: they say which node owns which range.)
\b(?:echo-ip|traefik-ha|controller|local-path-provisioner|store|payments)-\K[bcdfghjklmnpqrstvwxz2456789]{5,10}\b
\b(?:echo-ip|traefik-ha|controller|local-path-provisioner|store|payments)-\.\.\.-\K[bcdfghjklmnpqrstvwxz2456789]{5}\b
\bspeaker-\K[bcdfghjklmnpqrstvwxz2456789]{5}\b
\b(?:80|443):\K3(?!0080/|0443/)[0-9]{4}(?=/TCP)
KUBE-SEP-\K[A-Z0-9]{16}\b
\b(?:[0-9a-f]{2}:){5}[0-9a-f]{2}\b
^after about \K[0-9]+ s and [0-9]+ calls \([0-9]+(?= failed\))
^calls: \K[0-9]+, failed: [0-9]+, the last one about [0-9]+(?= s after the pause)
\b[A-Z][a-z]{2} [0-9]{2}, [0-9]{4} [0-9]{2}:[0-9]{2} UTC\b
^the kubeconfig's API server: https://127\.0\.0\.1:\K[0-9]+$
