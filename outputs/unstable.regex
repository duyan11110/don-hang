# One Perl regular expression per line. Whatever a line matches is replaced by
# "..." in every captured output, so that a re-run of the same script produces
# the same file. \K keeps everything before it out of the match.
^Date: \K.*$
^Etag: \K.*$
^Last-Modified: \K.*$
^ *notBefore=\K.*$
^ *notAfter=\K.*$
^\K[0-9]+(?= +sleep )
 in \K[^\n]*[/\\](?=[A-Za-z0-9_]+\.cs:line )
"placedAt":"\K[^"]*(?=")
"id":\K[0-9]+(?=,"customerId")
actual time=\K[0-9.]+\.\.[0-9.]+
^ *Planning Time: \K[0-9.]+(?= ms$)
^ *Execution Time: \K[0-9.]+(?= ms$)
Executed DbCommand \(\K[0-9]+(?=ms\))
[?&]code=\K[^&\s]+
[?&]session_state=\K[^&\s]+
seconds left on \S+: \K[0-9]+
while locking tuple \K\([0-9]+,[0-9]+\)
^subject: Order \K[0-9]+
^Notification \K[0-9]+(?= failed)
^(?:http|donhang)_\w+(?:\{.*\})? \K\S+$
 => \K\S+$
"ElapsedMs": ?\K[0-9]+
responded [0-9]+ in \K[0-9]+(?=ms)
# Kubernetes (scripts/k8s/): kind's start-up time, AGE and "(… ago)" in kubectl's
# tables, the random part of a Pod or ReplicaSet name, Pod and Service IP
# addresses, and which worker node a Pod landed on.
^ • Ready after \K\S+
(?<=   )(?:[0-9]+[smhd]){1,2}(?=   |$)
\(\K(?:[0-9]+[smhd]){1,2}(?= ago\))
\b(?:web|api|coredns|kindnet|kube-proxy|db|redis|keycloak|mailpit)-\K[bcdfghjklmnpqrstvwxz2456789]{5,10}\b
\b(?:web|api|coredns|db|redis|keycloak|mailpit)-\.\.\.-\K[bcdfghjklmnpqrstvwxz2456789]{5}\b
\b10\.244\.[0-9]+\.[0-9]+\b
\b10\.96\.(?!0\.1\b|0\.10\b)[0-9]+\.[0-9]+\b
(?<=   )donhang-worker\K2?(?=   |$)
pod-template-hash=\K[bcdfghjklmnpqrstvwxz2456789]{5,10}\b
